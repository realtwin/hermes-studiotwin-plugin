{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hermes-studiotwin:contracts:gateway-v1",
  "title": "hermes-studiotwin gateway protocol v1 (frozen, S03)",
  "description": "Types shared by the profile-scoped stdio gateway (S04-S10, S24) and its consumers. Exact-match versioning: a message whose protocol is not studiotwin.gateway.v1 receives VersionRefusalV1.",
  "x-studiotwin-version": {
    "contract": "studiotwin.gateway.v1",
    "major": 1,
    "compatibility": "exact-match",
    "onMismatch": "refuse",
    "refusalCode": "INCOMPATIBLE_PROTOCOL_VERSION"
  },
  "$defs": {
    "ProtocolV1": {
      "const": "studiotwin.gateway.v1",
      "description": "Exact-match protocol label. Any other value is refused."
    },
    "Sha256HexV1": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "EpochMsV1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799999
    },
    "CreditsV1": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "TrustedIdV1": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "Host-issued identifier copied from authenticated TrustedToolContextV1 (D31)."
    },
    "LocalIdV1": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "EvidenceRefV1": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "description": "Job-specific server ledger reference (e.g. fixture-ledger-<uuid>)."
    },
    "ToolNameV1": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "AssetIdV1": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "JobIdV1": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "OperationIdV1": {
      "type": "string",
      "pattern": "^op_[A-Za-z0-9_-]{43}$",
      "description": "Random 256-bit single-use operation ID (base64url, no padding)."
    },
    "ScopeIdV1": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Keyed HMAC of ScopeTupleV1 (§5.4). Never a raw key or account identifier."
    },
    "OpaqueHandleV1": {
      "type": "string",
      "pattern": "^sth_[A-Za-z0-9_-]{43}$",
      "description": "256-bit scoped opaque handle (D09/D20). Identity free; resolves only in the gateway."
    },
    "SliceIdV1": {
      "type": "string",
      "pattern": "^S(?:0[1-9]|[12][0-9]|30)$"
    },
    "MimeV1": {
      "type": "string",
      "pattern": "^(?:image|audio|video|model|application|text)/[a-z0-9][a-z0-9.+-]{0,63}$"
    },
    "ScopedMediaPathV1": {
      "type": "string",
      "pattern": "^(?:/|[A-Za-z]:/)(?:(?!\\.{1,2}(?:/|$))[A-Za-z0-9_. -]{1,128}/){0,24}hermes-studiotwin/scopes/[0-9a-f]{64}/media/(?:(?!\\.{1,2}(?:/|$))[A-Za-z0-9_. -]{1,128}/){0,8}(?!\\.{1,2}(?:/|$))[A-Za-z0-9_. -]{1,128}$",
      "description": "Absolute POSIX or slash-normalized Windows drive path; hidden ancestors and spaces supported. Syntax only: verify current scope/generation and approved root, resolve(strict=True), open and fstat before reading; reject symlink escape, wrong owner/permissions, nonregular file, disallowed extension/MIME and size overflow. Never percent-decode this path.",
      "maxLength": 4096
    },
    "MediatedTextV1": {
      "type": "string",
      "maxLength": 4000,
      "x-studiotwin-mediated-text": true,
      "description": "Text that has passed the S06/S07 result-mediation boundary (D20). Never carries a URL, storage URI, presigned field, query string or credential.",
      "not": {
        "anyOf": [
          {
            "pattern": "[A-Za-z][A-Za-z0-9+.-]*://"
          },
          {
            "pattern": "(^|[^A-Za-z0-9])[Ss]3:"
          },
          {
            "pattern": "(^|[^A-Za-z0-9])data:[^\\s,]*[;,]"
          },
          {
            "pattern": "[Xx]-[Aa][Mm][Zz]-"
          },
          {
            "pattern": "[A-Za-z0-9_.-]=[^\\s]"
          },
          {
            "pattern": "[?&][A-Za-z0-9_.-]+="
          },
          {
            "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]"
          }
        ]
      }
    },
    "RunKindV1": {
      "enum": [
        "interactive",
        "cron",
        "api",
        "kanban"
      ]
    },
    "EnforcementModeV1": {
      "enum": [
        "interim-local",
        "server-max-credits"
      ]
    },
    "TierV1": {
      "enum": [
        "setup",
        "offline-read",
        "hosted-read",
        "hosted-mutation",
        "paid"
      ]
    },
    "VersionRefusalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "ok",
        "error"
      ],
      "description": "The only reply to a message whose protocol label is not exactly studiotwin.gateway.v1.",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/ProtocolV1"
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "supported",
            "received",
            "message"
          ],
          "properties": {
            "code": {
              "const": "INCOMPATIBLE_PROTOCOL_VERSION"
            },
            "supported": {
              "const": [
                "studiotwin.gateway.v1"
              ]
            },
            "received": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[A-Za-z0-9._-]{0,64}$",
              "description": "The received label; null when absent or not a short label string."
            },
            "message": {
              "$ref": "#/$defs/MediatedTextV1"
            }
          }
        }
      }
    },
    "ConsentV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "action",
        "rememberKey",
        "elicitationId"
      ],
      "description": "Once-only acceptance of the exact in-flight MCP form elicitation (§5.3). No remember key.",
      "properties": {
        "channel": {
          "const": "mcp-elicitation-form"
        },
        "action": {
          "const": "accept"
        },
        "rememberKey": {
          "type": "null"
        },
        "elicitationId": {
          "type": "string",
          "pattern": "^el_[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "AuthorizationV1": {
      "type": "object",
      "additionalProperties": false,
      "description": "Created only inside the gateway after authenticated TrustedToolContextV1 and once-only MCP elicitation acceptance (§7.1). Paid authorization is interactive-only; paid Concept tools are refused until D22.",
      "required": [
        "protocol",
        "operationId",
        "scopeId",
        "trustedSessionId",
        "runKind",
        "runId",
        "tool",
        "schemaHash",
        "canonicalInputHash",
        "enforcementMode",
        "previewId",
        "previewPriceVersion",
        "previewExpiresAtMs",
        "estimatedCredits",
        "maxCredits",
        "expiresAtMs",
        "createdAtMs",
        "consent",
        "contextSource"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/ProtocolV1",
          "x-enforcement": {
            "interim-local": "envelope",
            "server-max-credits": "envelope"
          }
        },
        "operationId": {
          "$ref": "#/$defs/OperationIdV1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeIdV1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        },
        "trustedSessionId": {
          "$ref": "#/$defs/TrustedIdV1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        },
        "runKind": {
          "const": "interactive",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          },
          "description": "cron/api/kanban paid budget is zero in v1 (D15)."
        },
        "runId": {
          "$ref": "#/$defs/TrustedIdV1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        },
        "tool": {
          "$ref": "#/$defs/ToolNameV1",
          "not": {
            "enum": [
              "studiotwin_conceptlab_create_and_generate",
              "studiotwin_conceptlab_generate",
              "studiotwin_conceptlab_edit"
            ]
          },
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        },
        "schemaHash": {
          "$ref": "#/$defs/Sha256HexV1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        },
        "canonicalInputHash": {
          "$ref": "#/$defs/Sha256HexV1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        },
        "enforcementMode": {
          "$ref": "#/$defs/EnforcementModeV1",
          "x-enforcement": {
            "interim-local": "envelope",
            "server-max-credits": "envelope"
          }
        },
        "previewId": {
          "type": "string",
          "pattern": "^pv_[A-Za-z0-9_-]{43}$",
          "x-enforcement": {
            "interim-local": "local-preview",
            "server-max-credits": "local-preview"
          }
        },
        "previewPriceVersion": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "x-enforcement": {
            "interim-local": "local-preview",
            "server-max-credits": "local-preview"
          }
        },
        "previewExpiresAtMs": {
          "$ref": "#/$defs/EpochMsV1",
          "x-enforcement": {
            "interim-local": "local-preview",
            "server-max-credits": "local-preview"
          }
        },
        "estimatedCredits": {
          "$ref": "#/$defs/CreditsV1",
          "x-enforcement": {
            "interim-local": "local-preview",
            "server-max-credits": "local-preview"
          }
        },
        "maxCredits": {
          "$ref": "#/$defs/CreditsV1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "server-enforced"
          },
          "x-display-label": {
            "interim-local": "approved estimate",
            "server-max-credits": "server-enforced maximum"
          }
        },
        "serverQuoteToken": {
          "type": "string",
          "pattern": "^sqt_[A-Za-z0-9_-]{43}$",
          "x-enforcement": {
            "interim-local": "absent",
            "server-max-credits": "server-enforced"
          },
          "description": "Opaque server quote handle (D30). Absent in interim-local mode."
        },
        "expiresAtMs": {
          "$ref": "#/$defs/EpochMsV1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        },
        "createdAtMs": {
          "$ref": "#/$defs/EpochMsV1",
          "x-enforcement": {
            "interim-local": "local-preview",
            "server-max-credits": "local-preview"
          }
        },
        "consent": {
          "$ref": "#/$defs/ConsentV1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        },
        "contextSource": {
          "const": "trusted-tool-context-v1",
          "x-enforcement": {
            "interim-local": "local-enforced",
            "server-max-credits": "local-enforced"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "enforcementMode"
            ],
            "properties": {
              "enforcementMode": {
                "const": "interim-local"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "serverQuoteToken"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "enforcementMode"
            ],
            "properties": {
              "enforcementMode": {
                "const": "server-max-credits"
              }
            }
          },
          "then": {
            "required": [
              "serverQuoteToken"
            ]
          }
        }
      ]
    },
    "ReservationStateV1": {
      "enum": [
        "AUTHORIZED",
        "RESERVED_UNSENT",
        "DISPATCHING",
        "ACCEPTED",
        "UNKNOWN",
        "UNKNOWN_NOT_VISIBLE",
        "RELEASED",
        "EXPIRED",
        "SETTLED",
        "SETTLED_OVERRUN",
        "REFUNDED_VERIFIED"
      ]
    },
    "UnknownV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "const": "unknown"
        }
      },
      "description": "No evidence. Never zero, never null credits."
    },
    "SubmissionCostV1": {
      "oneOf": [
        {
          "$ref": "#/$defs/UnknownV1"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "credits",
            "evidence"
          ],
          "properties": {
            "state": {
              "const": "reported"
            },
            "credits": {
              "$ref": "#/$defs/CreditsV1"
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "job-reported-submission-cost"
                },
                "ref": {
                  "$ref": "#/$defs/EvidenceRefV1"
                }
              }
            }
          }
        }
      ],
      "description": "The job's own cost field. Never final-ledger evidence."
    },
    "FinalDebitV1": {
      "oneOf": [
        {
          "$ref": "#/$defs/UnknownV1"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "credits",
            "evidence"
          ],
          "properties": {
            "state": {
              "const": "reported"
            },
            "credits": {
              "$ref": "#/$defs/CreditsV1"
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "const": "job-specific-final-debit"
                },
                "ref": {
                  "$ref": "#/$defs/EvidenceRefV1"
                }
              }
            }
          }
        }
      ]
    },
    "RefundV1": {
      "oneOf": [
        {
          "$ref": "#/$defs/UnknownV1"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "credits",
            "evidence"
          ],
          "properties": {
            "state": {
              "const": "reported"
            },
            "credits": {
              "$ref": "#/$defs/CreditsV1"
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ref"
              ],
              "properties": {
                "kind": {
                  "const": "job-specific-refund"
                },
                "ref": {
                  "$ref": "#/$defs/EvidenceRefV1"
                }
              }
            }
          }
        }
      ]
    },
    "ActualCostV1": {
      "oneOf": [
        {
          "$ref": "#/$defs/UnknownV1"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "credits",
            "derivedFrom"
          ],
          "properties": {
            "state": {
              "const": "known"
            },
            "credits": {
              "$ref": "#/$defs/CreditsV1"
            },
            "derivedFrom": {
              "const": "job-specific-final-debit"
            }
          }
        }
      ],
      "description": "Known only from a job-specific verified final debit; wallet deltas and submission cost never count."
    },
    "AccountBalanceContextV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "balanceBefore",
        "balanceAfter",
        "attributedToJob"
      ],
      "description": "Shared wallet balance, account-level display context only; never allocated to a job.",
      "properties": {
        "level": {
          "const": "account"
        },
        "balanceBefore": {
          "type": "integer"
        },
        "balanceAfter": {
          "type": "integer"
        },
        "attributedToJob": {
          "const": false
        }
      }
    },
    "ReconciliationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operationId",
        "scopeId",
        "jobId",
        "enforcementMode",
        "state",
        "estimatedCredits",
        "reservedCredits",
        "submissionCost",
        "finalDebit",
        "refund",
        "actualCost",
        "reservationHeld",
        "scopePaused"
      ],
      "description": "Three distinct nullable facts (§7.2): submission cost, final debit, refund. SETTLED_OVERRUN additionally needs finalDebit.credits > estimatedCredits, which JSON Schema cannot compare; S10 enforces it.",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/ProtocolV1"
        },
        "operationId": {
          "$ref": "#/$defs/OperationIdV1"
        },
        "scopeId": {
          "$ref": "#/$defs/ScopeIdV1"
        },
        "jobId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/JobIdV1"
            }
          ]
        },
        "enforcementMode": {
          "$ref": "#/$defs/EnforcementModeV1"
        },
        "state": {
          "$ref": "#/$defs/ReservationStateV1"
        },
        "estimatedCredits": {
          "$ref": "#/$defs/CreditsV1"
        },
        "reservedCredits": {
          "$ref": "#/$defs/CreditsV1"
        },
        "submissionCost": {
          "$ref": "#/$defs/SubmissionCostV1"
        },
        "finalDebit": {
          "$ref": "#/$defs/FinalDebitV1"
        },
        "refund": {
          "$ref": "#/$defs/RefundV1"
        },
        "actualCost": {
          "$ref": "#/$defs/ActualCostV1"
        },
        "reservationHeld": {
          "type": "boolean"
        },
        "scopePaused": {
          "type": "boolean"
        },
        "accountBalanceContext": {
          "$ref": "#/$defs/AccountBalanceContextV1"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "actualCost"
            ],
            "properties": {
              "actualCost": {
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "known"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "finalDebit"
            ],
            "properties": {
              "finalDebit": {
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "reported"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "SETTLED",
                  "SETTLED_OVERRUN"
                ]
              }
            }
          },
          "then": {
            "required": [
              "actualCost"
            ],
            "properties": {
              "actualCost": {
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "known"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "SETTLED_OVERRUN"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "scopePaused": {
                "const": true
              },
              "enforcementMode": {
                "const": "interim-local"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "REFUNDED_VERIFIED"
                ]
              }
            }
          },
          "then": {
            "required": [
              "refund"
            ],
            "properties": {
              "refund": {
                "required": [
                  "state"
                ],
                "properties": {
                  "state": {
                    "const": "reported"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "UNKNOWN",
                  "UNKNOWN_NOT_VISIBLE"
                ]
              }
            }
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "actualCost"
                ],
                "properties": {
                  "actualCost": {
                    "required": [
                      "state"
                    ],
                    "properties": {
                      "state": {
                        "const": "unknown"
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "finalDebit"
                ],
                "properties": {
                  "finalDebit": {
                    "required": [
                      "state"
                    ],
                    "properties": {
                      "state": {
                        "const": "unknown"
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "reservationHeld": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "RESERVED_UNSENT",
                  "DISPATCHING",
                  "ACCEPTED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reservationHeld": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "RELEASED",
                  "EXPIRED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reservationHeld": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "ACCEPTED",
                  "SETTLED",
                  "SETTLED_OVERRUN",
                  "REFUNDED_VERIFIED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "jobId": {
                "$ref": "#/$defs/JobIdV1"
              }
            }
          }
        }
      ]
    },
