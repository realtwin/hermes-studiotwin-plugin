    "PublicationDecisionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "hostCapabilities",
        "principalIdentity",
        "publishedTiers"
      ],
      "description": "Anything beyond setup needs a proven principal (D24), a host at/above the floor and every HostCapabilitiesV1 flag true (D31). Otherwise only setup is published.",
      "properties": {
        "protocol": {
          "$ref": "#/$defs/ProtocolV1"
        },
        "hostCapabilities": {
          "$ref": "urn:hermes-studiotwin:contracts:host-gateway-v1#/$defs/HostCapabilitiesV1"
        },
        "principalIdentity": {
          "enum": [
            "proven",
            "unproven"
          ]
        },
        "publishedTiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TierV1"
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "setup"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "principalIdentity",
              "hostCapabilities"
            ],
            "properties": {
              "principalIdentity": {
                "const": "proven"
              },
              "hostCapabilities": {
                "required": [
                  "hostVersionStatus",
                  "capabilities"
                ],
                "properties": {
                  "hostVersionStatus": {
                    "const": "at-or-above-floor"
                  },
                  "capabilities": {
                    "properties": {
                      "trustedToolContextV1": {
                        "const": true
                      },
                      "onceOnlyElicitation": {
                        "const": true
                      },
                      "noWriteReplay": {
                        "const": true
                      },
                      "portableMcpOwnership": {
                        "const": true
                      },
                      "pluginBackendNamespace": {
                        "const": true
                      },
                      "profileScopedInterpolationFailClosed": {
                        "const": true
                      },
                      "gatewayMigration": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          },
          "then": true,
          "else": {
            "properties": {
              "publishedTiers": {
                "items": {
                  "const": "setup"
                }
              }
            }
          }
        }
      ]
    },
    "CapabilityEntryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "family",
        "schemaHash",
        "fixedCost",
        "classification",
        "executable",
        "disabledReason"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/ToolNameV1"
        },
        "family": {
          "enum": [
            "generation",
            "platform",
            "concept"
          ]
        },
        "schemaHash": {
          "$ref": "#/$defs/Sha256HexV1"
        },
        "fixedCost": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/CreditsV1"
            }
          ]
        },
        "classification": {
          "enum": [
            "classified",
            "discovered_unclassified"
          ]
        },
        "executable": {
          "type": "boolean"
        },
        "disabledReason": {
          "enum": [
            null,
            "concept-paid-d22",
            "unclassified",
            "schema-changed",
            "host-trusted-context-absent",
            "host-capability-missing",
            "host-version-unproven",
            "principal-unproven",
            "scope-paused",
            "interim-mode-not-accepted"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "executable"
            ],
            "properties": {
              "executable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "disabledReason": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "disabledReason": {
                "not": {
                  "const": null
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "classification"
            ],
            "properties": {
              "classification": {
                "const": "discovered_unclassified"
              }
            }
          },
          "then": {
            "properties": {
              "executable": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "enum": [
                  "studiotwin_conceptlab_create_and_generate",
                  "studiotwin_conceptlab_generate",
                  "studiotwin_conceptlab_edit"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "executable": {
                "const": false
              }
            }
          }
        }
      ]
    },
