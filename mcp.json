{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "studiotwin": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/gateway/run.py"
      ],
      "cwd": "${PLUGIN_DATA}",
      "env": {
        "STUDIOTWIN_API_KEY": "${STUDIOTWIN_API_KEY}",
        "STUDIOTWIN_EXPERT_API_KEY": "${STUDIOTWIN_EXPERT_API_KEY}"
      }
    }
  }
}
